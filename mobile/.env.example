# Servidor de la API: mock (en Kubero) o ti2 (backend de Taller de Integracion 2)
# Las URLs reales van solo en mobile/.env (pedirlas al equipo).
EXPO_PUBLIC_API_DESTINO=mock
EXPO_PUBLIC_API_URL_MOCK=https://scgi-api.inf.uct.cl/api
EXPO_PUBLIC_API_URL_TI2=
# Opcionales: URL propia de cada microservicio de TI2. Las vacias usan EXPO_PUBLIC_API_URL_TI2.
EXPO_PUBLIC_API_URL_TI2_AUTENTICACION=
EXPO_PUBLIC_API_URL_TI2_ACTIVOS=
EXPO_PUBLIC_API_URL_TI2_INCIDENCIAS=
EXPO_PUBLIC_API_URL_TI2_NOTIFICACIONES=

EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=